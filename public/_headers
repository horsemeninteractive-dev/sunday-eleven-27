# Cloudflare Pages caching for a hashed-asset single-page build.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry document names the hashed bundles, so it must never be cached: a
# browser holding a stale one keeps loading last build's files.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The service worker is the one file that decides which of the above rules
# apply, so a cached copy of it outlives the deploy it was written for and pins
# the game to it. Nothing else in the build may be treated this way.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
